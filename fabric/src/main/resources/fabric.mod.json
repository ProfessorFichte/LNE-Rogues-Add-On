{
	"schemaVersion": 1,
	"id": "lne_rogues",
	"version": "${version}",
	"name": "L&E Rogues-Add On",
	"description": "Loot & Explore Add-On with Rogues RPG-Series Content.",
	"authors": [
		"Fichte"
	],
	"contact": {
		"sources": "https://github.com/ProfessorFichte/LNE-Wizards-Add-On"
	},
	"license": "ARR",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.lne_rogues.fabric.FabricMod"
		],
		"client": [
			"com.lne_rogues.fabric.client.FabricClient"
		],
		"fabric-datagen": [
			"com.lne_rogues.Lne_roguesDataGenerator"
		]
	},
	"mixins": [
		"lne_rogues.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=17",
		"fabric-api": "*",
		"spell_engine": ">=${spell_engine_version}",
		"rogues": ">=${rogues_version}"
	},
	"suggests": {
		"loot_n_explore": ">=1.0.2-1.21.1"
	}
}